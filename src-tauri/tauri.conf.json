{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Taurus",
  "version": "0.3.0",
  "identifier": "com.lukeus.taurus",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && node scripts/conpty.mjs",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ5RjE1ODYyODkxRkU5RTAKUldUZzZSK0pZbGp4MlhDRHo2YXVHWWNCaGZjRVNmbUcyV245d202cFV2OEp2VlVhOWRmWUd4UFAK",
      "endpoints": [
        "https://github.com/Lukeus/taurus/releases/latest/download/latest.json"
      ]
    }
  },
  "app": {
    "windows": [
      {
        "title": "Taurus",
        "width": 1180,
        "height": 820,
        "minWidth": 720,
        "minHeight": 520,
        "dragDropEnabled": false,
        "backgroundColor": "#0b0f14"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
